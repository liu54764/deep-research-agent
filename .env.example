# Copy to .env.local and fill in real values. .env.local is gitignored.
DRA_API_KEY=dev-key
MYSQL_ROOT_PASSWORD=root

# Real LLM (DeepSeek / OpenAI-compatible). Leave disabled for stub mode.
DRA_LLM_ENABLED=false
DRA_LLM_BASE_URL=https://api.deepseek.com
DRA_LLM_API_KEY=
DRA_LLM_PLAN_MODEL=deepseek-chat
DRA_LLM_EXTRACT_MODEL=deepseek-chat
DRA_LLM_CLAIM_MODEL=deepseek-chat
DRA_LLM_VERIFY_MODEL=deepseek-reasoner

# Search: mock | tavily
DRA_SEARCH_PROVIDER=mock
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
TAVILY_TIMEOUT_SECONDS=30

# Fetch: stub | http (http = real pages, SSRF-guarded, static HTML only)
DRA_FETCH_MODE=stub
DRA_FETCH_TIMEOUT_SECONDS=20
DRA_FETCH_MAX_BYTES=3145728
DRA_FETCH_MAX_REDIRECTS=3
DRA_FETCH_USER_AGENT=DeepResearchAgent/0.1

# Optional outbound proxy for Tavily and page fetching (e.g. Clash)
DRA_HTTP_PROXY=
DRA_HTTP_CONNECT_TIMEOUT_SECONDS=10
